{
  "name": "kedro-website",
  "private": true,
  "scripts": {
    "build": "node ./generateRobotsTxt.js && next build",
    "dev": "next dev",
    "format": "prettier --write .",
    "lint": "next lint",
    "setup": "node ./contentful/setup.js",
    "sign-off": "make sign-off",
    "start": "next start",
    "test": "jest --watch",
    "test:ci": "npm test -- --watchAll=false --maxWorkers=2"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.10",
    "@contentful/rich-text-react-renderer": "^15.12.1",
    "@netlify/edge-functions": "^2.11.0",
    "classnames": "^2.3.2",
    "framer-motion": "^6.2.7",
    "next": "^16.2.12",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-markdown": "^8.0.5",
    "react-syntax-highlighter": "^15.5.0",
    "sass": "^1.49.7",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.1",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.0.38",
    "@types/react-syntax-highlighter": "^15.5.6",
    "asciinema-player": "^3.6.3",
    "contentful-import": "^8.5.0",
    "eslint": "8.8.0",
    "eslint-config-next": "12.0.10",
    "eslint-config-prettier": "^8.3.0",
    "feed": "^4.2.2",
    "husky": "^8.0.3",
    "jest": "^27.4.7",
    "lint-staged": "^13.2.1",
    "prettier": "^2.5.1",
    "typescript": "^4.5.5"
  },
  "overrides": {
    "@babel/runtime": "^7.26.10",
    "axios": ">=1.8.2",
    "brace-expansion": ">=5.0.8",
    "flatted": ">=3.4.2",
    "form-data": "^4.0.6",
    "immutable": ">=5.1.8",
    "js-yaml": ">=4.3.0",
    "jsonpath": ">=1.2.0",
    "jsdom": {
      "form-data": "^3.0.5"
    },
    "lodash": ">=4.18.0",
    "micromatch": ">=4.0.8",
    "minimatch": ">=3.1.3",
    "nanoid": ">=3.3.8",
    "picomatch": ">=2.3.2",
    "postcss": ">=8.5.18",
    "prismjs": ">=1.30.0",
    "seroval": ">=1.5.3",
    "solid-js": ">=1.9.4",
    "uuid": ">=11.1.1",
    "ws": ">=7.5.11",
    "yaml": ">=2.8.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test:ci"
    }
  },
  "lint-staged": {
    "*/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --single-quote --write"
    ],
    "*/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
